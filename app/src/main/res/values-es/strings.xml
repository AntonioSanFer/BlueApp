<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="tagline">Rompe el reflejo de abrir y hacer scroll.</string>

    <string name="service_label">Pausa de BlueApp</string>
    <string name="service_summary">Muestra una pausa corta antes de las apps que elegiste.</string>
    <string name="service_description">BlueApp solo usa esto para saber qué app se acaba de abrir y mostrar una pausa antes de las apps que elegiste. No lee lo que hay en tu pantalla, no ve lo que escribes y no tiene acceso a internet: nada sale de tu móvil.</string>
    <string name="one_minute_left">Queda 1 minuto</string>

    <string name="step_of">Paso %1$d de %2$d</string>
    <string name="welcome_title">Abre con intención,\nno por reflejo.</string>
    <string name="welcome_body">Tu pulgar sabe dónde está TikTok antes de que decidas abrirlo. BlueApp pone una pausa corta en medio para que decidas tú.</string>
    <string name="welcome_points">⏸  Una pausa cada vez que abres una app elegida: una cuenta atrás o un reto rápido.\n\n🎲  Cambia cada vez, así no se convierte en costumbre que saltas sin pensar.\n\n⏱  Tú eliges cuánto tiempo necesitas. Cuando se acaba, la app se cierra.\n\n🔋  Funciona por eventos, sin sondeo en segundo plano. Nada sale de tu móvil.</string>
    <string name="get_started">Empezar</string>
    <string name="next">Siguiente</string>
    <string name="back">Atrás</string>
    <string name="finish">Terminar</string>
    <string name="done">Listo</string>

    <string name="apps_title">¿Qué apps llevan pausa?</string>
    <string name="apps_body">Toca para añadir o quitar. Los cambios se aplican al momento.</string>
    <string name="apps_body_onboarding">Recomendamos TikTok, Instagram y YouTube, y ya están seleccionadas. Añade cualquier otra app que abras sin pensar.</string>
    <string name="apps_body_none_installed">Recomendamos TikTok, Instagram y YouTube, pero no tienes ninguna instalada. Elige las apps que abres sin pensar.</string>
    <string name="recommended">Recomendada</string>
    <string name="pick_one">Elige al menos una app</string>
    <string name="no_apps">Ninguna app seleccionada</string>

    <string name="session_title">¿Cuánto puede durar una sesión?</string>
    <string name="session_body">Después de cada pausa eliges cuánto tiempo necesitas, hasta este límite. Cuando se acaba, la app se cierra y para volver hace falta otra pausa.</string>
    <string name="minutes_label">minutos</string>

    <string name="perm_title">Un permiso, otro opcional</string>
    <string name="perm_body">BlueApp necesita saber cuándo se abre una app elegida. Es lo único que mira.</string>
    <string name="perm_access_name">Accesibilidad</string>
    <string name="perm_access_desc">Solo se usa para detectar qué app acaba de pasar al frente. BlueApp no puede leer tu pantalla ni lo que escribes, y no tiene permiso de internet. En la lista, abre BlueApp → activa «Pausa de BlueApp».</string>
    <string name="perm_restricted_hint">¿El interruptor está gris? Android lo bloquea para apps instaladas fuera de Play Store. Toca Info de la app → ⋮ (arriba a la derecha) → Permitir ajustes restringidos, y vuelve a intentarlo.</string>
    <string name="perm_overlay_name">Mostrar sobre otras apps</string>
    <string name="perm_overlay_desc">Opcional. Algunos móviles (Xiaomi, Oppo, Vivo, Huawei…) no dejan abrir la pausa sin esto.</string>
