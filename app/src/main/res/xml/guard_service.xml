<?xml version="1.0" encoding="utf-8"?>
<!-- Battery notes:
     - Only window-state changes (an app/screen coming to the front). No content, no
       scrolling, no text, no key events. Each event is a cheap string comparison.
     - canRetrieveWindowContent=false: the system never builds view trees for us. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="150"
    android:description="@string/service_description"
    android:summary="@string/service_summary" />
