<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ===== Bases: wire the platform to our attributes. Palettes below only set colors. ===== -->

    <style name="Base.App.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:colorControlActivated">?attr/accentColor</item>
        <item name="android:windowBackground">?attr/bgColor</item>
        <item name="android:statusBarColor">?attr/bgColor</item>
        <item name="android:navigationBarColor">?attr/bgColor</item>
        <item name="android:textColorPrimary">?attr/textMain</item>
        <item name="android:textColorSecondary">?attr/textDim</item>
        <item name="goodColor">#47D18C</item>
        <item name="warnColor">#FFB547</item>
    </style>

    <style name="Base.App.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">?attr/accentColor</item>
        <item name="android:colorAccent">?attr/accentColor</item>
        <item name="android:colorControlActivated">?attr/accentColor</item>
        <item name="android:windowBackground">?attr/bgColor</item>
        <item name="android:statusBarColor">?attr/bgColor</item>
        <item name="android:navigationBarColor">?attr/bgColor</item>
        <item name="android:textColorPrimary">?attr/textMain</item>
        <item name="android:textColorSecondary">?attr/textDim</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="goodColor">#1E9E5A</item>
        <item name="warnColor">#B86E00</item>
    </style>

    <!-- ===== Palettes ===== -->

    <!-- Default: deep navy with a bright blue. -->
    <style name="Theme.App.Blue" parent="Base.App.Dark">
        <item name="bgColor">#0B1220</item>
        <item name="surfaceColor">#141E33</item>
        <item name="surface2Color">#1C2942</item>
        <item name="outlineColor">#2A3A5C</item>
        <item name="accentColor">#4C8DFF</item>
        <item name="onAccentColor">#FFFFFF</item>
        <item name="accent2Color">#7FD3FF</item>
        <item name="onAccent2Color">#06283D</item>
        <item name="textMain">#EAF0FF</item>
        <item name="textDim">#93A3C4</item>
    </style>

    <!-- True black: OLED pixels switched off, the most battery-friendly option. -->
    <style name="Theme.App.Amoled" parent="Base.App.Dark">
        <item name="bgColor">#000000</item>
        <item name="surfaceColor">#0D0D10</item>
        <item name="surface2Color">#17171C</item>
        <item name="outlineColor">#25252C</item>
        <item name="accentColor">#8AB4FF</item>
        <item name="onAccentColor">#071A3D</item>
        <item name="accent2Color">#C6A8FF</item>
        <item name="onAccent2Color">#1F0D45</item>
        <item name="textMain">#F2F2F5</item>
        <item name="textDim">#9A9AA6</item>
    </style>

    <style name="Theme.App.Light" parent="Base.App.Light">
        <item name="bgColor">#F5F7FB</item>
        <item name="surfaceColor">#FFFFFF</item>
        <item name="surface2Color">#EDF1F8</item>
        <item name="outlineColor">#D5DCE8</item>
        <item name="accentColor">#2F6BEA</item>
        <item name="onAccentColor">#FFFFFF</item>
        <item name="accent2Color">#0E8FB8</item>
        <item name="onAccent2Color">#FFFFFF</item>
        <item name="textMain">#111827</item>
        <item name="textDim">#5B6476</item>
    </style>

    <style name="Theme.App.Forest" parent="Base.App.Dark">
        <item name="bgColor">#0C1511</item>
        <item name="surfaceColor">#13211A</item>
        <item name="surface2Color">#1A2C23</item>
        <item name="outlineColor">#2A4236</item>
        <item name="accentColor">#4CC38A</item>
        <item name="onAccentColor">#03150C</item>
        <item name="accent2Color">#E3C45C</item>
        <item name="onAccent2Color">#2A2000</item>
        <item name="textMain">#E7F3EC</item>
        <item name="textDim">#93AE9F</item>
    </style>

    <style name="Theme.App.Sunset" parent="Base.App.Dark">
        <item name="bgColor">#1A0F14</item>
        <item name="surfaceColor">#25161D</item>
        <item name="surface2Color">#311F28</item>
        <item name="outlineColor">#48303B</item>
        <item name="accentColor">#FF7A59</item>
        <item name="onAccentColor">#2A0A00</item>
        <item name="accent2Color">#FFC15E</item>
        <item name="onAccent2Color">#2E1A00</item>
        <item name="textMain">#FBEDEF</item>
        <item name="textDim">#C2A3AA</item>
    </style>

    <!-- Applied on top of any palette for the pause screen. -->
    <style name="Overlay.Intercept" parent="">
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <!-- ===== Text & widget styles ===== -->

    <style name="Title">
        <item name="android:textColor">?attr/textMain</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Body">
        <item name="android:textColor">?attr/textDim</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Section">
        <item name="android:textColor">?attr/textDim</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Primary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">?attr/onAccentColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Secondary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">?attr/textMain</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">18dp</item>
    </style>
</resources>
