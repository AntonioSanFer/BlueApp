    <!-- Accessibility service -->
    <string name="service_label">BlueApp pause</string>
    <string name="service_summary">Shows a short pause before the apps you picked.</string>
    <string name="service_description">BlueApp only uses this to know which app just opened, so it can show a pause before the apps you chose. It does not read what is on your screen, does not see what you type, and has no internet access, so nothing ever leaves your phone.</string>
    <string name="one_minute_left">1 minute left</string>

    <!-- Onboarding -->
    <string name="step_of">Step %1$d of %2$d</string>
    <string name="welcome_title">Open apps on purpose</string>
    <string name="welcome_body">BlueApp adds a short pause before the apps you open out of habit, and a time limit once you\'re in.</string>
    <string name="next">Continue</string>
    <string name="back">Back</string>
    <string name="finish">Finish</string>

    <string name="apps_title">Which apps get a pause?</string>
    <string name="apps_body">Tap to add or remove. Changes apply right away.</string>
    <string name="apps_body_onboarding">TikTok, Instagram and YouTube are recommended and already selected. Add any other app you open without thinking.</string>
    <string name="apps_body_none_installed">We recommend TikTok, Instagram and YouTube, but none are installed. Pick the apps you open without thinking.</string>
    <string name="recommended">Recommended</string>
    <string name="pick_one">Pick at least one app</string>
    <string name="no_apps">No apps selected</string>

    <string name="session_title">Time options</string>
    <string name="session_body">Pick up to 4 lengths. After each pause you choose one of them, and the longest is your limit per session.</string>

    <string name="perm_title">One permission, one optional</string>
    <string name="perm_body">BlueApp needs to know when a chosen app opens. That\'s all it looks at.</string>
    <string name="perm_access_name">Accessibility</string>
    <string name="perm_access_desc">Used only to detect which app just came to the front. BlueApp can\'t read your screen or what you type, and it has no internet permission. In the list, open BlueApp → turn on “BlueApp pause”.</string>
    <string name="perm_restricted_hint">Switch greyed out? Android blocks this for apps installed outside the Play Store. Tap App info → ⋮ (top right) → Allow restricted settings, then try again.</string>
    <string name="perm_overlay_name">Display over other apps</string>
    <string name="perm_overlay_desc">Optional. Some phones (Xiaomi, Oppo, Vivo, Huawei…) won\'t let the pause screen open without it.</string>
